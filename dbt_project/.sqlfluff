# Lint config for the dbt SQL.
#
# Uses the JINJA templater rather than the dbt templater on purpose: the dbt
# templater needs a resolvable warehouse profile, which would make linting fail
# on a fork or without credentials. Stub macros below let sqlfluff render
# ref/source/config/var without dbt being connected to anything.

[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 100
exclude_rules = ST06, RF01, RF02, RF03, RF04, AM05, ST07, CV12, LT05

[sqlfluff:indentation]
indented_joins = false
indented_ctes = false
allow_implicit_indents = true
template_blocks_indent = false

[sqlfluff:layout:type:comma]
line_position = trailing

# The models deliberately column-align their AS aliases: with 24 models and a
# lot of renaming, aligned aliases are markedly easier to scan in review. Tell
# sqlfluff that alignment is intended rather than stray whitespace.
[sqlfluff:layout:type:alias_expression]
spacing_before = align
align_within = select_clause
align_scope = bounded

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent

[sqlfluff:templater:jinja]
# sqlfluff ships stubs for ref/source/config/var/is_incremental, so we do not
# have to hand-roll them. Project macros are loaded from disk so br_region(),
# lateness_bucket() and excluded_statuses() render for real.
apply_dbt_builtins = true
load_macros_from_path = macros,dbt_packages/dbt_utils/macros/sql

[sqlfluff:templater:jinja:context]
target = {"name": "dev", "schema": "dbt_lint"}
