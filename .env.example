# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------
GCP_PROJECT_ID=your-project-id-here
GCP_LOCATION=US
GCS_RAW_BUCKET=your-project-id-here-olist-raw
GCS_RAW_PREFIX=olist/raw/v1

# BigQuery datasets (shared, created once by the Platform Owner)
BQ_DATASET_RAW=olist_raw
BQ_DATASET_STAGING=olist_staging
BQ_DATASET_MARTS=olist_marts
BQ_DATASET_SNAPSHOTS=olist_snapshots

# ---------------------------------------------------------------
# dbt
# ---------------------------------------------------------------
# Your personal development dataset: dbt_<yourname>
DBT_DEV_DATASET=dbt_yourname
# dev | prod   (prod writes to the shared staging/marts datasets)
DBT_TARGET=dev

# ---------------------------------------------------------------
# Local paths
# ---------------------------------------------------------------
LOCAL_RAW_DIR=data/raw

# ---------------------------------------------------------------
# Dataset provenance (recorded into the manifest and data dictionary)
# ---------------------------------------------------------------
OLIST_SOURCE_URL=https://www.kaggle.com/datasets/olistbr/brazilian-ecommerce
OLIST_LICENCE=CC BY-NC-SA 4.0
# The date the CSVs were downloaded, and the analytical "today" for RFM recency.
OLIST_SNAPSHOT_DATE=2018-10-17
